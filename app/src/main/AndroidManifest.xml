<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="GoogleAppIndexingWarning">

        <!-- Background music service -->
        <service
            android:name=".MusicService"
            android:enabled="true"
            android:exported="false" />

        <!-- Launcher / entry point -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main screens (not exported — only reachable within the app) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".LearnActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".QuizMenuActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".QuizScoreActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <!-- Belajar sub-screens -->
        <activity
            android:name=".belajar.HijaiyahLearningActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".belajar.FathahLearningActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".belajar.KasrohLearningActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".belajar.DhommahLearningActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".belajar.FatainLearningActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".belajar.KastainLearningActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".belajar.DhotainLearningActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <!-- Kuis sub-screens -->
        <activity
            android:name=".kuis.HijaiyahQuizActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".kuis.FathahQuizActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".kuis.KasrohQuizActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".kuis.DhommahQuizActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".kuis.FatainQuizActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".kuis.KastainQuizActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".kuis.DotainQuizActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

    </application>

</manifest>